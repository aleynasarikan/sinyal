{
  "name": "sinyal",
  "version": "0.1.0",
  "description": "SİNYAL — bağımsız çok dilli medya istihbaratı ve olay analizi platformu (MVP)",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/main.ts",
    "start": "bun run src/main.ts",
    "migrate": "bun run src/store/migrate_cli.ts",
    "eval": "bun run src/eval/cli.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "check": "bunx tsc --noEmit && bun test"
  },
  "devDependencies": {
    "@types/bun": "1.2.23",
    "@types/topojson-client": "3.1.5",
    "i18n-iso-countries": "7.14.0",
    "topojson-client": "3.1.0",
    "typescript": "5.9.3",
    "world-atlas": "2.0.2"
  },
  "dependencies": {
    "maplibre-gl": "6.14.0"
  }
}
