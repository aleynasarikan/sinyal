# SİNYAL örnek yapılandırma — `cp .env.example .env` ile kopyalayıp değerleri doldurun.
# GÜVENLİK: .env Git'e EKLENMEZ. Buradaki değerler yalnız örnek/sahtedir.

# ---- Sunucu ----
HOST=127.0.0.1
PORT=8790
SINYAL_PUBLIC_ORIGIN=http://localhost:8080,http://127.0.0.1:8080
# HTTPS olmayan yerel ortamda 0; üretimde (TLS arkasında) 1 bırakın.
SINYAL_COOKIE_SECURE=0
# Yalnız nginx arkasında 1 (X-Real-IP'ye güvenilir)
SINYAL_TRUST_PROXY=0

# ---- Depo: memory | clickhouse ----
SINYAL_STORE=memory
CLICKHOUSE_URL=http://127.0.0.1:8124
CLICKHOUSE_DB=sinyal
CLICKHOUSE_USER=sinyal
CLICKHOUSE_PASSWORD=degistirin-guclu-bir-parola-ornek

# ---- Veri sağlayıcı: mock | umi_api ----
SINYAL_DATA_PROVIDER=mock
# UMİ entegrasyonu: yalnız kurumca yetkilendirilmiş, belgelenmiş, salt-okunur API için doldurun.
UMI_API_BASE_URL=
UMI_API_KEY=
UMI_API_CONTRACT_VERIFIED=0

# ---- Model sağlayıcı: mock | openai (OpenAI uyumlu Chat Completions) ----
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2
# 1 = modele tam metin gönderilir (varsayılan: yalnız başlık + ilk paragraf)
LLM_SEND_FULLTEXT=0
LLM_MAX_CHARS_PER_ARTICLE=1200

# ---- Hız sınırları (dakika başına) ----
SINYAL_RATE_LOGIN_PER_MIN=5
SINYAL_RATE_API_PER_MIN=300
SINYAL_RATE_ANALYSIS_PER_MIN=6

# ---- Başlangıç hesapları ----
SINYAL_ADMIN_EMAIL=admin@sinyal.local
# Boş bırakılırsa rastgele üretilir ve SINYAL_SEED_PASSWORD_FILE dosyasına (0600) yazılır.
SINYAL_ADMIN_PASSWORD=
SINYAL_SEED_PASSWORD_FILE=var/.sinyal-seed-password
# 1 = demo analist ve izleyici hesapları da oluşturulur (yalnız geliştirme)
SINYAL_DEMO_USERS=0
